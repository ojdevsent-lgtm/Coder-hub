rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(roomId) {
      return signedIn()
        && get(/databases/$(database)/documents/rooms/$(roomId)).data.ownerId == request.auth.uid;
    }

    function isMember(roomId) {
      return signedIn()
        && exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid));
    }

    match /rooms/{roomId} {
      // Room documents contain metadata only; project source lives under /files.
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if isMember(roomId)
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isOwner(roomId);

      match /members/{userId} {
        allow read: if isMember(roomId) || isOwner(roomId);
        allow create, update: if signedIn() && userId == request.auth.uid;
        allow delete: if signedIn()
          && (userId == request.auth.uid || isOwner(roomId));
      }

      match /files/{fileId} {
        allow read: if isMember(roomId);
        allow create: if isMember(roomId)
          && request.resource.data.ownerId == request.auth.uid;
        allow update: if isMember(roomId)
          && resource.data.ownerId == request.auth.uid;
        allow delete: if isOwner(roomId) || (
          isMember(roomId) && resource.data.ownerId == request.auth.uid
        );
      }

      match /messages/{messageId} {
        allow read: if isMember(roomId);
        allow create: if isMember(roomId)
          && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isMember(roomId)
          && resource.data.userId == request.auth.uid;
      }
    }
  }
}
